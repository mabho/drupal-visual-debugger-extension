{
  "manifest_version": 3,
  "name": "Drupal Visual Debugger",
  "version": "0.1.0",
  "description": "Overlays Drupal Twig theme-debug info and an inspector panel on the current page. Requires Twig debugging enabled on the site.",
  "action": {
    "default_title": "Toggle Drupal Visual Debugger"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["lib/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
